# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Base64 / PEM)
# Ed25519 PEM keys for JWT signing & verification
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KID=k1

# 64 random bytes base64-encoded for Crockford code HMAC hashing
HMAC_PEPPER=dGVzdF9wZXBwZXJfNjRfYnl0ZXNfbG9uZ19zdHJpbmdfZXhhbXBsZV9mb3JfdjJfYmFja2VuZF9zZWNyZXQ=

# 32 random bytes base64-encoded for AES-256-GCM encryption (TOTP secrets & code export)
TOTP_ENCRYPTION_KEY=dGVzdF8zMl9ieXRlc19rZXlfMTIzNDU2Nzg5MDEyMzQ1Ng==

# 32 random bytes base64-encoded for signed media URLs HMAC
SIGNED_URL_SECRET=c2lnbmVkX3VybF9zZWNyZXRfMzJfYnl0ZXNfbG9uZ19leGFtcGxl

# Admin session cookie / secret
ADMIN_SESSION_SECRET=YWRtaW5fc2Vzc2lvbl9zZWNyZXRfMzJfYnl0ZXNfZXhhbXBsZQ==

# Supabase Storage & Service Role
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
STORAGE_BUCKET=member-media

# Application Settings
ENVIRONMENT=staging
CORS_ORIGINS=https://panel.dayjournal.app,http://localhost:3000
API_HOST=https://api.dayjournal.app
CONFIG_VERSION=1
